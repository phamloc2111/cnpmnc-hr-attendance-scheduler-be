DB_URL=jdbc:postgresql://localhost:5432/hr_attendance
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Set a random JWT signing secret of at least 32 bytes for persistent sessions.
JWT_SECRET=
# Explicit, one-time account provisioning. No accounts are created by default.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional test accounts for local development, supplied by you.
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_EMPLOYEE_EMAIL=
BOOTSTRAP_EMPLOYEE_PASSWORD=

# Google AI Studio / Gemini, used to read the time and location overlay on Timemark photos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Keep this below the five-second FR19 response budget.
GEMINI_TIMEOUT_MS=4000

# Required for two-layer attendance verification. Use the coordinates of the work site.
WORKPLACE_LATITUDE=10.879909033376816
WORKPLACE_LONGITUDE=106.80612565057567
WORKPLACE_RADIUS_METERS=100
# Maximum difference between the Timemark timestamp and the server clock.
TIMEMARK_MAX_TIME_DIFFERENCE_SECONDS=300

# NeonDB pooled connection example
# DB_URL=jdbc:postgresql://ep-example-pooler.region.aws.neon.tech/hr_attendance?sslmode=require
# DB_USERNAME=your_neon_user
# DB_PASSWORD=your_neon_password
